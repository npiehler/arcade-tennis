# ---------------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------------
# Generated caches and local state. Library/ alone is 2.3 GB here and is fully
# rebuilt by Unity from Assets/ + ProjectSettings/ + Packages/.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Meta files must travel with their asset, so never ignore them wholesale.
!/[Aa]ssets/**/*.meta

# Autogenerated Rider / Visual Studio project files -- Unity regenerates these.
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Build output
*.apk
*.aab
*.unitypackage
*.app

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Project specific
# ---------------------------------------------------------------------------
# Plastic SCM workspace metadata. Present but unused; Git is the VCS here.
.plastic/

# Local editor configuration.
.vscode/

# Screenshots written by `unity cmd capture_game_view`, which resolves its path
# against the authoring root and drops files into Assets/. They are scratch.
/[Aa]ssets/[Tt]emp/
/[Aa]ssets/[Tt]emp.meta

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
